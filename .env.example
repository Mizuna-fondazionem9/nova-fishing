# NOVA Fishing — variables d'environnement. Copier en `.env` pour le local ; sur Railway, les saisir dans l'onglet Variables.
# Ne jamais committer de vraies valeurs.

# --- Obligatoires en production ---
NODE_ENV=production
# Adresse publique du jeu, en https, sans barre finale.
PUBLIC_URL=https://exemple.up.railway.app
# PostgreSQL. Sur Railway : ${{Postgres.DATABASE_URL}} (adapter « Postgres » au nom de votre service de base).
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base
# Chaîne aléatoire d'au moins 32 caractères (signe le cookie temporaire OAuth).
SESSION_SECRET=
# Application Discord (portail développeur > OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Facultatives ---
# Port HTTP. Railway le fournit tout seul : ne pas le définir là-bas.
# PORT=3000
# Schéma PostgreSQL dédié au jeu (créé automatiquement, isolé des tables de NovaBot).
# DB_SCHEMA=nova_fishing
# Mettre 1 seulement si DATABASE_URL est l'adresse PUBLIQUE de la base (connexion TLS).
# DATABASE_SSL=0
# Par défaut : PUBLIC_URL + /auth/discord/callback
# DISCORD_REDIRECT_URI=
# Graine du monde. NE PLUS LA CHANGER après l'ouverture : elle définit toute la carte.
# WORLD_SEED=20261111
# Jeton (24 caractères ou plus) qui active l'API interne des récompenses pour NovaBot. Absent = API désactivée.
# INTERNAL_API_TOKEN=
# Pour afficher le jeu dans une iframe d'un autre site (valeur CSP frame-ancestors).
# FRAME_ANCESTORS='self' https://novabot-hub.fr

# --- Développement uniquement (refusées si NODE_ENV=production) ---
# Connexion sans Discord, bouton « Entrer sans Discord » sur l'écran d'accueil.
# DEV_AUTH=1
# Sans DATABASE_URL, le stockage est en mémoire ; ce fichier le rend persistant en local.
# MEMORY_STORE_FILE=.data/store.json
